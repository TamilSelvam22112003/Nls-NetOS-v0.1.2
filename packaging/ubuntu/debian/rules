#!/usr/bin/make -f

export DH_VERBOSE=1

%:
	dh $@

override_dh_auto_configure:
	@echo "NLS-NetOS: no configure step"

override_dh_auto_build:
	$(MAKE) -C ../../../platform/drivers/nic -f Makefile

override_dh_auto_install:
	@echo "NLS-NetOS: files are installed by dh_install"

override_dh_auto_test:
	@echo "NLS-NetOS: tests are not run by the package build"
